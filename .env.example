# Gmail account used to send contact form emails
GMAIL_USER=your-sending-account@gmail.com

# Gmail App Password (requires 2-Step Verification enabled on GMAIL_USER)
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=your-16-character-app-password

# Where contact form leads should be delivered
CONTACT_TO_EMAIL=leads@example.com

# Optional: separate inbox for internship registrations (defaults to CONTACT_TO_EMAIL)
# INTERNSHIP_TO_EMAIL=internships@example.com

# Admin dashboard (/admin) sign-in password
ADMIN_PASSWORD=choose-a-long-random-password

# Optional: secret used to sign admin session cookies (defaults to ADMIN_PASSWORD).
# Changing it signs everyone out.
# ADMIN_SESSION_SECRET=another-long-random-string

# Optional: folder where form submissions are stored as JSON (defaults to ./data)
# SUBMISSIONS_DIR=/var/lib/craftlanee
